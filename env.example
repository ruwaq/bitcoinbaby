# BitcoinBaby — Root Environment Variables
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local or real secrets to the repository.

# =============================================================================
# API URLs
# =============================================================================
# Workers API (backend) - local dev default
NEXT_PUBLIC_WORKERS_API_URL=http://localhost:8787
# Charms Prover (v15 hosted)
NEXT_PUBLIC_PROVER_URL=https://v15.charms.dev

# =============================================================================
# Environment
# =============================================================================
NODE_ENV=development
# Phase: 1 = NFTs + Faucet, 2 = + Mining, 3 = + Game
NEXT_PUBLIC_PHASE=2

# =============================================================================
# Bitcoin Network
# =============================================================================
# Bitcoin network: testnet4 (dev) or mainnet (production)
NEXT_PUBLIC_NETWORK=testnet4

# =============================================================================
# App
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Bitcoin Addresses (testnet4 defaults)
# =============================================================================
# Dev Fund address (20% of mining rewards)
NEXT_PUBLIC_DEV_FUND_ADDRESS=
# Staking Pool address (10% of mining rewards)
NEXT_PUBLIC_STAKING_POOL_ADDRESS=
# BABTC Treasury address
NEXT_PUBLIC_BABTC_TREASURY_ADDRESS=

# =============================================================================
# Charms Contracts (testnet4)
# =============================================================================
NEXT_PUBLIC_BABTC_APP_ID=
NEXT_PUBLIC_BABTC_APP_VK=

# =============================================================================
# Workers API (Backend) — set via wrangler secret put in production
# These are for documentation only — do NOT paste real secrets here.
# =============================================================================
# UPSTASH_REDIS_REST_URL   — Redis URL for leaderboard cache
# UPSTASH_REDIS_REST_TOKEN — Redis auth token
# SCROLLS_API_KEY          — Charms Scrolls API key
# BATCH_WALLET_SEED        — Mnemonic for batch tx signing (NEVER commit!)
# TREASURY_ADDRESS         — Address holding BABTC for batch transfers
# FOUNDATION_ADDRESS       — Address receiving 20% platform fee
# CLAIM_SECRET_KEY         — HMAC key for claim proofs (32+ chars)
# ADMIN_KEY                — Admin API key for protected endpoints