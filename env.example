# BitcoinSparks — Root Environment Variables
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local or real secrets to the repository.

# =============================================================================
# API URLs
# =============================================================================
# Workers API (backend) - local dev default
NEXT_PUBLIC_WORKERS_API_URL=http://localhost:8787
# Workers API (production)
# NEXT_PUBLIC_WORKERS_API_URL=https://bitcoinbaby-api.andeanlabs-58f.workers.dev

# Charms Prover (v15 hosted)
NEXT_PUBLIC_PROVER_URL=https://v15.charms.dev

# Site URL (for SEO, canonical, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =============================================================================
# Environment
# =============================================================================
NODE_ENV=development
# Phase: 1 = NFTs + Faucet, 2 = + Mining, 3 = + Game
NEXT_PUBLIC_PHASE=2

# =============================================================================
# Bitcoin Network
# =============================================================================
# Bitcoin network: testnet4 (dev) or mainnet (production)
NEXT_PUBLIC_NETWORK=testnet4
# WARNING: Only set to mainnet after contracts are deployed
# NEXT_PUBLIC_NETWORK=mainnet

# =============================================================================
# Mainnet Configuration (required for production launch)
# =============================================================================
# SPARK Token mainnet App ID (SHA256 of genesis UTXO)
# NEXT_PUBLIC_SPARK_MAINNET_APP_ID=
# SPARK Token mainnet App VK (SHA256 of compiled WASM)
# NEXT_PUBLIC_SPARK_MAINNET_APP_VK=
# Genesis Sparks NFT mainnet App ID
# NEXT_PUBLIC_NFT_MAINNET_APP_ID=
# Genesis Sparks NFT mainnet App VK
# NEXT_PUBLIC_NFT_MAINNET_APP_VK=

# Mainnet Treasury addresses
# SPARK Treasury mainnet address (holds tokens for distribution)
# SPARK_TREASURY_MAINNET_ADDRESS=
# NFT Treasury mainnet address (receives NFT sale payments)
# NFT_TREASURY_MAINNET_ADDRESS=
# Dev Fund mainnet address (5% of mining rewards)
# DEV_FUND_MAINNET_ADDRESS=
# Staking Pool mainnet address (5% of mining rewards)
# STAKING_POOL_MAINNET_ADDRESS=

# =============================================================================
# Monitoring (optional)
# =============================================================================
# Sentry DSN for error tracking
# NEXT_PUBLIC_SENTRY_DSN=
# Cloudflare Analytics token
# NEXT_PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=

# =============================================================================
# Workers API (Backend) — set via wrangler secret put in production
# These are for documentation only — do NOT paste real secrets here.
# =============================================================================
# UPSTASH_REDIS_REST_URL   — Redis URL for leaderboard cache
# UPSTASH_REDIS_REST_TOKEN — Redis auth token
# SCROLLS_API_KEY          — Charms Scrolls API key
# BATCH_WALLET_SEED        — Mnemonic for batch tx signing (NEVER commit!)
# TREASURY_ADDRESS         — Address holding BABTC for batch transfers
# FOUNDATION_ADDRESS       — Address receiving 20% platform fee
# CLAIM_SECRET_KEY         — HMAC key for claim proofs (32+ chars)
# ADMIN_KEY                — Admin API key for protected endpoints