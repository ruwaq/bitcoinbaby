# BitcoinBaby Pre-commit Hook
# Runs secret scanning + prettier formatting on staged files.
# ESLint is intentionally NOT run here — it's enforced in CI via `turbo lint`.
# See the README "Linting strategy" section for the rationale.

echo "🔍 BitcoinBaby pre-commit checks..."

# Phase 1: Secret scanning (always runs first — blocks commit if secrets found)
./scripts/scan-secrets.sh || exit 1

# Phase 2: prettier --write on staged files (configured via root lint-staged)
npx lint-staged