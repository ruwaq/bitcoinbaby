# BitcoinBaby Pre-push Hook
# Runs contract VK reproducibility check (scripts/verify-vks.sh) in advisory
# mode, but ONLY when the push touches contract Rust sources. This catches
# stale WASM binaries at the moment someone changes lib.rs, without imposing
# cargo build latency on pushes that don't touch contracts (apps/web, docs,
# scripts, packages/*).
#
# Advisory: reports divergence but never blocks (exit 0). The current 3
# embedded binaries are intentionally stale-but-aligned-with-on-chain until
# the testnet4 reset (see docs/superpowers/notes/SESSION-9-HANDOFF.md §1).
# When GitHub Actions is re-enabled and the on-chain redeploy lands, this hook
# stays as the fast local guard; CI runs the same script with --strict.
#
# Skip entirely with:  VERIFY_VKS=0 git push

# Escape hatch.
[ "${VERIFY_VKS:-1}" = "0" ] && { echo "ℹ️  VK check skipped (VERIFY_VKS=0)"; exit 0; }

# A pre-push receives N lines on stdin, one per ref being pushed:
#   <local-ref> <local-sha> <remote-ref> <remote-sha>
# We check whether ANY ref range touches contract src/.
CONTRACTS_CHANGED=0
while read -r _local_ref _local_sha _remote_ref _remote_sha; do
  # Branch deletion (all-zero sha) — nothing to diff.
  case "$_local_sha" in
    0000000000000000000000000000000000000000) continue ;;
  esac
  # New branch (no remote sha) — diff against the empty tree.
  base="$_remote_sha"
  if [ "$base" = "0000000000000000000000000000000000000000" ]; then
    # Compare against the default merge-base trick: use an empty tree if unavailable.
    base=$(git hash-object -t tree /dev/null 2>/dev/null || echo "")
  fi
  if [ -n "$base" ]; then
    if git diff --name-only "$base" "$_local_sha" -- packages/bitcoin/contracts/*/src/ 2>/dev/null | grep -q .; then
      CONTRACTS_CHANGED=1
      break
    fi
  fi
done

if [ "$CONTRACTS_CHANGED" = "0" ]; then
  exit 0
fi

echo "🔍 Push touches contract sources — running VK reproducibility check (advisory)..."
echo
./scripts/verify-vks.sh || true
echo
echo "ℹ️  VK check is advisory — push continues regardless. Use --strict locally"
echo "    ('bash scripts/verify-vks.sh --strict') before a release/on-chain deploy."
exit 0
